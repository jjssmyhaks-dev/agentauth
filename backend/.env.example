# ── AgentAuth backend (NestJS) ─────────────────────────────────────────
# Copy to backend/.env and fill in.

# Postgres connection string (sslmode=require for managed providers)
DATABASE_URL=postgres://agentauth:agentauth@localhost:5432/agentauth

# Redis for one-time challenge nonces and rate limiting
REDIS_URL=redis://localhost:6379

# HTTP
PORT=4000
NODE_ENV=development

# CORS — set to your dashboard origin in production (defaults to * if unset)
CORS_ORIGIN=http://localhost:5173

# JWT signing keys (PEM). If unset, an EPHEMERAL key pair is generated per
# boot — tokens survive restarts only if these are set. Generate with:
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

# Token lifetime in minutes (default 10)
TOKEN_TTL_MINUTES=10

# Optional integrations
# SENTRY_DSN=
# KNOCK_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
